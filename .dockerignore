# ── Git ───────────────────────────────────────────────────────────────────────
.git
.gitignore

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments (local dev only) ─────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Local secrets & config overrides ─────────────────────────────────────────
.env
*.env
config.json
config/amplify_server/config.json
**/jira_connection.json
*.pem
*.key

.claude/
.claude-flow/
.firecrawl/

# ── macOS junk ────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Local launchers (not needed in container) ────────────────────────────────
amplify.sh
amplify.bat

# ── Test artifacts (keep image lean) ─────────────────────────────────────────
allure/
allure-results/
.pytest_cache/
tests/amplify_server/
tests/coordinator/
tests/runner/
tests/sample/

# ── Jira Insights local workspace (pulled Jira data) ──────────────────────────
report_history.json
src/jira_insights/workspace/

# ── Not part of the app image: local deployment files and the Grid backend (own images) ──
# (the coordinator and runner images are built from this same context but have their own lists:
#  Dockerfile.coordinator.dockerignore and Dockerfile.grid-runner.dockerignore)
config/
scripts/
docs/
pytest.ini
coordinator-requirements.txt
runner-requirements.txt
src/coordinator/
src/runner/
src/gridtest/
