# ── Amplify Insights — Standalone Streamlit App ───────────────────────────────
#
# Build:   docker build -f Dockerfile.insights -t amplify-insights .
# Run:     docker run -p 8501:8501 -v amplify-data:/app/data \
#            -e JWT_SECRET_KEY=<the same value QEA uses> amplify-insights
#          (Insights accepts sign-in links from QEA only when both use the same JWT_SECRET_KEY.
#           Sharing the /app/data volume with QEA is enough if neither sets it.)
# Under a path of QEA's host (OpenShift/Kubernetes: /jira-insights): -e STREAMLIT_SERVER_BASE_URL_PATH=jira-insights
# (pages, assets, WebSocket and the health check then live under /jira-insights/).
# ─────────────────────────────────────────────────────────────────────────────

ARG BASE_REGISTRY=
FROM ${BASE_REGISTRY}python:3.13-slim

WORKDIR /app

RUN chown -R 0:0 /app && chmod -R g=u /app

COPY amplify-requirements.txt .
RUN pip install --no-cache-dir --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org -r amplify-requirements.txt

COPY . .

ENV PORT=8501
ENV CONTAINER=1
ENV HOME=/tmp

RUN mkdir -p /app/data /app/workspaces /tmp/.streamlit && \
    chown -R 0:0 /app && chmod -R g=u /app && \
    chmod -R 777 /app/data /app/workspaces /tmp/.streamlit

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import os, urllib.request; p = os.environ.get('STREAMLIT_SERVER_BASE_URL_PATH', '').strip('/'); urllib.request.urlopen('http://localhost:8501/' + (p + '/' if p else '') + '_stcore/health', timeout=5)" || exit 1

# Started from amplify/ like the side-car (launcher.py), so Streamlit reads amplify/.streamlit/config.toml
# (upload limit, theme, iframe settings); app.py puts the repo root on sys.path itself.
WORKDIR /app/amplify
CMD ["streamlit", "run", "jira_insights/app.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0", \
     "--server.headless", "true", \
     "--browser.gatherUsageStats", "false"]
